{
  RNDF_CreatePlugin.pas
  Creates RNDFollowers.esp (ESL-flagged) from RealisticNeedsandDiseases.esp.

  For every hunger / thirst / fatigue / disease Ability that RND gives the player,
  it makes a copy whose magic effects have NO Papyrus script and NO
  "GetIsID Player" / RND_State conditions, so the abilities can be applied to followers
  by the RNDFollowers.dll plugin without touching the player's RND data.

  It also writes RNDFollowers_Forms.ini (EditorID -> local FormID), which the DLL reads.

  Usage: load ONLY RealisticNeedsandDiseases.esp (and its masters) in xEdit,
  select the RND plugin, Apply Script... RNDF_CreatePlugin. When closing xEdit,
  save RNDFollowers.esp.
}
unit RNDF_CreatePlugin;

const
  RND_NAME = 'RealisticNeedsandDiseases.esp';
  OUT_NAME = 'RNDFollowers.esp';

var
  rnd, outFile: IInterface;
  idx: TStringList;

function NewName(edid: string): string;
begin
  // RND_HungerSpell03 -> RNDF_HungerSpell03
  Result := 'RNDF_' + Copy(edid, 5, 200);
end;

function FindByEdid(f: IInterface; sig, edid: string): IInterface;
var
  g: IInterface;
begin
  Result := nil;
  g := GroupBySignature(f, sig);
  if Assigned(g) then Result := MainRecordByEditorID(g, edid);
end;

function CloneMgef(src: IInterface): IInterface;
var
  nn: string;
  r: IInterface;
begin
  nn := NewName(EditorID(src));
  r := FindByEdid(outFile, 'MGEF', nn);
  if Assigned(r) then begin
    Result := r;
    Exit;
  end;
  r := wbCopyElementToFile(src, outFile, True, True);
  SetElementEditValues(r, 'EDID', nn);
  if ElementExists(r, 'VMAD') then RemoveElement(r, 'VMAD');
  if ElementExists(r, 'Conditions') then RemoveElement(r, 'Conditions');
  Result := r;
end;

procedure CloneSpell(edid: string);
var
  src, sp, effs, eff, mg, nm: IInterface;
  i: integer;
  nn: string;
begin
  src := FindByEdid(rnd, 'SPEL', edid);
  if not Assigned(src) then begin
    AddMessage('  missing in RND: ' + edid);
    Exit;
  end;
  nn := NewName(edid);
  if Assigned(FindByEdid(outFile, 'SPEL', nn)) then Exit;

  sp := wbCopyElementToFile(src, outFile, True, True);
  SetElementEditValues(sp, 'EDID', nn);

  effs := ElementByName(sp, 'Effects');
  for i := 0 to ElementCount(effs) - 1 do begin
    eff := ElementByIndex(effs, i);
    mg := LinksTo(ElementByPath(eff, 'EFID'));
    if Assigned(mg) then begin
      nm := CloneMgef(mg);
      SetElementNativeValues(eff, 'EFID', GetLoadOrderFormID(nm));
    end;
  end;
  idx.Add(nn + '=0x' + IntToHex(GetLoadOrderFormID(sp) and $00FFFFFF, 6));
  AddMessage('  created ' + nn);
end;

procedure DoAll;
var
  i, s: integer;
  d: TStringList;
begin
  for i := 0 to 5 do CloneSpell('RND_HungerSpell0' + IntToStr(i));
  for i := 0 to 4 do CloneSpell('RND_ThirstSpell0' + IntToStr(i));
  for i := 2 to 4 do CloneSpell('RND_SleepSpell0' + IntToStr(i));

  d := TStringList.Create;
  d.Add('Witbane');
  d.Add('Rockjoint');
  d.Add('Rattles');
  d.Add('BrainRot');
  d.Add('BoneBreakFever');
  d.Add('Ataxia');
  for i := 0 to d.Count - 1 do
    for s := 0 to 2 do
      CloneSpell('RND_Disease' + d[i] + 'Stage' + IntToStr(s));
  d.Free;
end;

function Initialize: integer;
var
  path: string;
  i: integer;
begin
  Result := 0;
  rnd := FileByName(RND_NAME);
  if not Assigned(rnd) then begin
    AddMessage('ERROR: ' + RND_NAME + ' is not loaded.');
    Result := 1;
    Exit;
  end;

  outFile := FileByName(OUT_NAME);
  if not Assigned(outFile) then
    outFile := AddNewFileName(OUT_NAME, True);
  if not Assigned(outFile) then begin
    AddMessage('ERROR: could not create ' + OUT_NAME);
    Result := 1;
    Exit;
  end;

  // copied records reference Skyrim.esm, Dawnguard.esm, USSEP etc., so the new
  // plugin must list every master that RND itself has, in the same order
  for i := 0 to MasterCount(rnd) - 1 do
    AddMasterIfMissing(outFile, GetFileName(MasterByIndex(rnd, i)));
  AddMasterIfMissing(outFile, RND_NAME);
  // make sure the ESL flag is set before new records get their FormIDs
  SetElementNativeValues(ElementByIndex(outFile, 0), 'Record Header\Record Flags\ESL', 1);

  idx := TStringList.Create;
  idx.Add('; generated by RNDF_CreatePlugin.pas');
  idx.Add('[Forms]');
  idx.Add('Plugin=' + OUT_NAME);

  AddMessage('Cloning RND abilities...');
  DoAll;

  path := ProgramPath + 'Edit Scripts\RNDFollowers_Forms.ini';
  idx.SaveToFile(path);
  AddMessage('Form index saved: ' + path);
  ForceDirectories(DataPath + 'SKSE\Plugins');
  idx.SaveToFile(DataPath + 'SKSE\Plugins\RNDFollowers_Forms.ini');
  AddMessage('Also copied to: ' + DataPath + 'SKSE\Plugins\RNDFollowers_Forms.ini');
  idx.Free;
  AddMessage('Done. Save ' + OUT_NAME + ' when you close xEdit.');
end;

function Process(e: IInterface): integer;
begin
  // everything is done in Initialize; stop after the first selected record
  Result := 1;
end;

end.
